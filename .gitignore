# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info
.ruff_cache/

# Virtual environments
.venv

# Secret — real secrets only. .env.example is committed as a placeholder template.
.env
# Local-only overrides (e.g. .env.local pointing at a developer's own Postgres).
# Matches .env.local, .env.test, etc. — never commit any of them.
.env.*
!.env.example

# Agent / vector-store tooling artifacts (not part of the application)
*.rvf
*.rvf.lock
ruvector.db
**/ruvector.db

# Local file storage used in place of Supabase Storage when ENVIRONMENT=development
# (see app/services/file.py) — whatever a developer uploads locally stays local.
/uploads/
