{
  "version": 2,
  "builds": [
    {
      "src": "app/main.py",
      "use": "@vercel/python"
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "app/main.py"
    }
  ],
  "env": {
    "DB_HOST": "@DB_HOST",
    "DB_USER": "@DB_USER",
    "DB_PASSWORD": "@DB_PASSWORD",
    "DB_PORT": "@DB_PORT",
    "DB_NAME": "@DB_NAME",
    "SUPABASE_URL": "@SUPABASE_URL",
    "SUPABASE_SERVICE_KEY": "@SUPABASE_SERVICE_KEY",
    "JWT_SECRET_KEY": "@JWT_SECRET_KEY",
    "JWT_ALGORITHM": "@JWT_ALGORITHM",
    "JWT_TOKEN_EXPIRE_MINUTES": "@JWT_TOKEN_EXPIRE_MINUTES",
    "JWT_REFRESH_TOKEN_EXPIRE_DAYS": "@JWT_REFRESH_TOKEN_EXPIRE_DAYS",
    "ALLOWED_ORIGINS": "@ALLOWED_ORIGINS",
    "PRESENCE_BACKEND": "@PRESENCE_BACKEND",
    "PRESENCE_REDIS_TTL_SECONDS": "@PRESENCE_REDIS_TTL_SECONDS",
    "PRESENCE_PUBSUB_CHANNEL": "@PRESENCE_PUBSUB_CHANNEL",
    "REDIS_URL": "@REDIS_URL",
    "SMTP_HOST": "@SMTP_HOST",
    "SMTP_PORT": "@SMTP_PORT",
    "SMTP_USER": "@SMTP_USER",
    "SMTP_PASSWORD": "@SMTP_PASSWORD",
    "SMTP_FROM_NAME": "@SMTP_FROM_NAME",
    "SMTP_USE_TLS": "@SMTP_USE_TLS",
    "NOC_EMAIL_ADDRESSES": "@NOC_EMAIL_ADDRESSES"
  }
}
