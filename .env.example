# Copy to .env and fill with real values. NEVER commit the real .env.
# All values below are placeholders only.
#
# To run against a different database without touching .env, put the overrides in
# their own file and name it explicitly:
#
#     ENV_FILE=.env.local uv run alembic upgrade head
#     ENV_FILE=.env.local uv run uvicorn app.main:app --reload
#
# Naming the file is the safeguard: swapping .env in place leaves a window where
# a migration runs against production because the swap was forgotten. Any
# .env.* file is gitignored. OS environment variables still override the file.

# --- Environment ---
# development | staging | production. Production enforces stricter startup checks
# (requires Supabase storage creds and an explicit ALLOWED_ORIGINS list).
ENVIRONMENT="development"

# --- Database (PostgreSQL / PostGIS) ---
DB_HOST="your-db-host"
DB_NAME="postgres"
DB_PASSWORD="change-me"
DB_PORT="5432"
DB_USER="postgres"

# --- Supabase Storage ---
# Only used when ENVIRONMENT is not "development" — in development, uploads go
# to ./uploads on this machine instead (see app/services/file.py), so these can
# be left blank for local work.
# SUPABASE_SERVICE_KEY is a service_role key that bypasses RLS — treat as a root credential.
SUPABASE_SERVICE_KEY="your-supabase-service-role-key"
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_STORAGE_BUCKET="attachments"
# Base URL this backend is reachable at; used to build URLs for files stored
# locally in development. Only needed if not running on the default port 8000.
LOCAL_UPLOAD_BASE_URL="http://localhost:8000"

# --- Security / JWT ---
# Generate JWT_SECRET_KEY with: python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_ALGORITHM="HS256"
JWT_SECRET_KEY="generate-a-32+-char-random-secret"
JWT_TOKEN_EXPIRE_MINUTES="720"
JWT_REFRESH_TOKEN_EXPIRE_DAYS="7"

# Browser session cookies. For a separate frontend/backend domain in production,
# use AUTH_COOKIE_SECURE="true" and AUTH_COOKIE_SAMESITE="none" over HTTPS.
AUTH_COOKIE_NAME="fieldcore_access_token"
REFRESH_COOKIE_NAME="fieldcore_refresh_token"
AUTH_COOKIE_DOMAIN=
AUTH_COOKIE_SECURE="false"
AUTH_COOKIE_SAMESITE="lax"
SESSION_SLIDING_REFRESH_MINUTES="15"
PERFORMANCE_COOKIE_MAX_AGE_DAYS="30"

# --- CORS ---
# Comma-separated list of trusted browser origins. Leave empty to block all cross-origin requests.
# Example: ALLOWED_ORIGINS="https://app.example.com,http://localhost:5173"
ALLOWED_ORIGINS=

# --- Passkeys / WebAuthn (optional) ---
PASSKEY_RP_NAME="FieldCore"
PASSKEY_RP_ID=
PASSKEY_ALLOWED_ORIGINS=

# --- Celery (task queue for notifications/email/webhooks) ---
# Leave unset for local/dev (tasks run inline). Set in production.
CELERY_BROKER_URL=
CELERY_RESULT_BACKEND=
# CELERY_TASK_ALWAYS_EAGER="false"

# --- Background scheduler (SLA + weekly checkers) ---
SCHEDULER_ENABLED="true"
SLA_CHECK_INTERVAL_MINUTES="5"
WEEKLY_CHECK_HOUR_UTC="6"

# --- Presence ---
PRESENCE_BACKEND="db"
PRESENCE_REDIS_TTL_SECONDS="300"
PRESENCE_PUBSUB_CHANNEL="presence_events"
REDIS_URL=

# --- Email / SMTP ---
SMTP_HOST="sandbox.smtp.mailtrap.io"
SMTP_PORT="2525"
SMTP_USER="your-smtp-user"
SMTP_PASSWORD="your-smtp-password"
SMTP_FROM_NAME="SAMO NOC"
SMTP_USE_TLS="true"
NOC_EMAIL_ADDRESSES="noc@example.com"
